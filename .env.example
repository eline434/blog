# Local: start the database with `npm run db:up`, then use this URL as is.
# Vercel: filled in automatically when you connect a Neon database.
DATABASE_URL=postgres://postgres:postgres@127.0.0.1:54329/bachelorlog

# Long random string. Generate one with: openssl rand -hex 32
PAYLOAD_SECRET=

# Vercel only: filled in automatically when you connect a Blob store.
# Leave empty locally, uploads are then stored in ./media.
BLOB_READ_WRITE_TOKEN=
